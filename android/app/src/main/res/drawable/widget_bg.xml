<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's card. Hard-coded dark on purpose: a home-screen widget has no
     app theme to inherit, and Lockin's surface is the dark one. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <solid android:color="#14161C" />
    <stroke
        android:width="1dp"
        android:color="#262A33" />
</shape>
