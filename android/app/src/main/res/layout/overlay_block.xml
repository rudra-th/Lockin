<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F708090C"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <ImageView
            android:id="@+id/block_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_block_shield" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.18"
            android:text="@string/block_kicker"
            android:textAllCaps="true"
            android:textColor="#C6F24E"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/block_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="#EEF0E6"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/block_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-light"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:text="00:00"
            android:textColor="#EEF0E6"
            android:textSize="64sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/block_left"
            android:textColor="#A7AC9E"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/block_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="220dp"
            android:layout_height="3dp"
            android:layout_marginTop="24dp"
            android:indeterminate="false"
            android:max="1000"
            android:progress="1000"
            android:progressBackgroundTint="#26FFFFFF"
            android:progressTint="#C6F24E" />

        <TextView
            android:id="@+id/block_until"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:fontFamily="monospace"
            android:textColor="#71766A"
            android:textSize="11sp" />

        <Button
            android:id="@+id/block_leave"
            android:layout_width="220dp"
            android:layout_height="54dp"
            android:layout_marginTop="38dp"
            android:background="@drawable/bg_alarm_primary"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/block_leave"
            android:textAllCaps="false"
            android:textColor="#0B0D12"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/block_foot"
            android:textColor="#71766A"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
