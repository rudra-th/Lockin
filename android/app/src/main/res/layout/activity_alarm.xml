<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08090C"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="48dp"
    android:paddingEnd="32dp"
    android:paddingBottom="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.18"
        android:text="@string/alarm_kicker"
        android:textAllCaps="true"
        android:textColor="#C6F24E"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/alarm_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-light"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:letterSpacing="-0.02"
        android:text="00:00"
        android:textColor="#EEF0E6"
        android:textSize="88sp" />

    <View
        android:layout_width="40dp"
        android:layout_height="2dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="24dp"
        android:background="#C6F24E" />

    <TextView
        android:id="@+id/alarm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:gravity="center"
        android:text="@string/alarm_default_title"
        android:textColor="#EEF0E6"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/alarm_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="#A7AC9E"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:gravity="center"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/alarm_dismiss"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_alarm_quiet"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/alarm_dismiss"
            android:textAllCaps="false"
            android:textColor="#A7AC9E"
            android:textSize="15sp"
            app:backgroundTint="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/alarm_open"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_alarm_primary"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/alarm_open"
            android:textAllCaps="false"
            android:textColor="#0B0D12"
            android:textSize="15sp"
            app:backgroundTint="@null" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:fontFamily="sans-serif"
        android:text="@string/alarm_foot"
        android:textColor="#71766A"
        android:textSize="11sp" />
</LinearLayout>
