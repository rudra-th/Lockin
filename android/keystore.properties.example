# Lockin release signing — copy this file to android/keystore.properties and
# fill in the real values. The keystore file itself stays OUTSIDE git
# (*.jks / *.keystore are gitignored) and backed up somewhere safe: losing it
# means a new app identity on Google Play.
#
# storeFile may be absolute, or relative to android/app/ (e.g. lockin-release.jks
# placed next to build.gradle).
storeFile=lockin-release.jks
storePassword=CHANGE_ME
keyAlias=lockin
keyPassword=CHANGE_ME
